<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PersianVet</RootNamespace>
    <AssemblyName>PersianVet</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <None Update="configuracion.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="..\BaseDatos\*.sql" LinkBase="BaseDatos">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Recursos\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Controles\UcCitas.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controles\UcClientes.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controles\UcConsultas.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controles\UcDashboard.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controles\UcMascotas.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controles\UcReportes.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controles\UcTarifas.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controles\UcVacunas.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Controles\UcVeterinarios.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Formularios\FrmLogin.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Formularios\FrmPrincipal.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Formularios\FrmUsuarios.cs"><SubType>Form</SubType></Compile>
  </ItemGroup>
</Project>
